# Build context: antidrift/
FROM oven/bun:1 AS builder
WORKDIR /build
COPY zeromcp/nodejs/ ./nodejs/
RUN cd nodejs && bun install && bun run build

FROM oven/bun:1
WORKDIR /bench
COPY --from=builder /build/nodejs/dist/ ./zeromcp/
COPY --from=builder /build/nodejs/node_modules/ ./node_modules/
COPY zeromcp-benchmarks/runtimes/http-frameworks/server-bare.mjs .
COPY zeromcp/nodejs/examples/tools/ ./tools/

ENV PORT=3000
EXPOSE 3000
CMD ["bun", "run", "server-bare.mjs"]
