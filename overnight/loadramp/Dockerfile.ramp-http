# Build context: antidrift/
FROM node:22
WORKDIR /bench

# Build ZeroMCP
COPY zeromcp/nodejs/ /zeromcp/nodejs/
RUN cd /zeromcp/nodejs && npm install && npm run build

# Copy benchmark tools
COPY zeromcp-benchmarks/node/tools-bench/ tools/

# Harness
COPY zeromcp-benchmarks/overnight/loadramp/ramp-to-kill-http.mjs .
COPY zeromcp-benchmarks/package.json .

CMD ["node", "ramp-to-kill-http.mjs"]
